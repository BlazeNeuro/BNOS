#!/bin/sh
set -e

echo "BNOS: Applying branding and desktop shell configuration..."

# --- Configure system environment & cursor theme ---
cat > /etc/environment << 'ENV_EOF'
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24
QT_QPA_PLATFORM=wayland
GDK_BACKEND=wayland
MOZ_ENABLE_WAYLAND=1
ENV_EOF

# --- Configure greetd for auto-login in live mode ---
mkdir -p /etc/greetd
cat > /etc/greetd/config.toml << 'GREETD_EOF'
[terminal]
vt = 7

[default_session]
command = "agreety --cmd /usr/local/bin/bnos-session"
user = "_greetd"

# Auto-login for the live session — straight to desktop
[initial_session]
command = "/usr/local/bin/bnos-session"
user = "live"
GREETD_EOF

# --- Create session launch script ---
cat > /usr/local/bin/bnos-session << 'SESSION_EOF'
#!/bin/sh
# BNOS Wayland Session Launcher
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=BNOS
export XDG_SESSION_DESKTOP=BNOS
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export XCURSOR_THEME=Adwaita
export XCURSOR_SIZE=24

# Initialize standard user directories
xdg-user-dirs-update 2>/dev/null || true

exec labwc
SESSION_EOF
chmod +x /usr/local/bin/bnos-session

# --- Create .desktop session entry for display managers ---
mkdir -p /usr/share/wayland-sessions
cat > /usr/share/wayland-sessions/bnos.desktop << 'DESKTOP_EOF'
[Desktop Entry]
Name=BNOS
Comment=BlazeNeuro Operating System
Exec=/usr/local/bin/bnos-session
Type=Application
DesktopNames=BNOS
DESKTOP_EOF

# --- Create default user folders in /etc/skel ---
mkdir -p /etc/skel/Desktop
mkdir -p /etc/skel/Documents
mkdir -p /etc/skel/Downloads
mkdir -p /etc/skel/Music
mkdir -p /etc/skel/Pictures
mkdir -p /etc/skel/Videos
mkdir -p /etc/skel/Projects

# Welcome guide document
cat > /etc/skel/Desktop/Welcome-to-BNOS.txt << 'WELCOME_EOF'
======================================================
  Welcome to BNOS (BlazeNeuro Operating System) 1.0
======================================================
Founder: Ankit | BlazeNeuro
Base: Debian GNU/Linux 13 (Trixie)
Desktop Shell: BNOS Shell (Qt 6 + QML, shadcn/ui design tokens, Solar Icons)
Core Backend: High-performance C++ & D-Bus system architecture

Desktop Navigation & Controls:
  - Top Bar: Workspaces 1-4, Clock & Calendar, System Status, Control Center
  - Bottom Dock: Applications Launcher, Files, Browser, Software Store, Terminal, Settings
  - Super or F1: Open Application Drawer
  - Ctrl + Alt + L: Lock Screen
  - Esc: Close active windows and drawers

Enjoy your personalized, high-performance computing experience!
WELCOME_EOF
cp /etc/skel/Desktop/Welcome-to-BNOS.txt /etc/skel/Documents/

# --- labwc configuration ---
mkdir -p /etc/skel/.config/labwc

# labwc autostart: launches the native BNOS Shell (Panel, Dock, Wallpaper)
cat > /etc/skel/.config/labwc/autostart << 'AUTOSTART_EOF'
# BNOS Desktop Autostart
if [ -x /usr/bin/bnos-shell ]; then
    bnos-shell &
else
    foot &
fi
AUTOSTART_EOF
chmod +x /etc/skel/.config/labwc/autostart

# labwc environment
cat > /etc/skel/.config/labwc/environment << 'ENV_EOF'
XDG_CURRENT_DESKTOP=BNOS
MOZ_ENABLE_WAYLAND=1
QT_QPA_PLATFORM=wayland
XCURSOR_THEME=Adwaita
XCURSOR_SIZE=24
ENV_EOF

# labwc right-click menu
cat > /etc/skel/.config/labwc/menu.xml << 'MENU_EOF'
<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="root-menu" label="BNOS">
    <item label="Files"><action name="Execute"><command>bnos-shell</command></action></item>
    <item label="Terminal"><action name="Execute"><command>foot</command></action></item>
    <item label="Firefox"><action name="Execute"><command>firefox-esr</command></action></item>
    <item label="File Manager (Thunar)"><action name="Execute"><command>thunar</command></action></item>
    <separator />
    <item label="System Info"><action name="Execute"><command>foot -e fastfetch</command></action></item>
    <separator />
    <item label="Reconfigure"><action name="Reconfigure" /></item>
    <item label="Exit"><action name="Exit" /></item>
  </menu>
</openbox_menu>
MENU_EOF

# --- Enable greetd service ---
systemctl enable greetd.service 2>/dev/null || true

# --- Set default locale ---
echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
locale-gen
update-locale LANG=en_US.UTF-8

# --- Create live user matching boot parameters ---
if ! id -u live > /dev/null 2>&1; then
    useradd -m -G sudo,audio,video,plugdev,netdev -s /bin/bash live
    echo "live:live" | chpasswd
    # Copy skeleton files
    cp -r /etc/skel/. /home/live/
    chown -R live:live /home/live
fi

if ! id -u user > /dev/null 2>&1; then
    useradd -m -G sudo,audio,video,plugdev,netdev -s /bin/bash user
    echo "user:live" | chpasswd
    cp -r /etc/skel/. /home/user/
    chown -R user:user /home/user
fi

echo "BNOS: Branding and desktop configuration applied successfully."
