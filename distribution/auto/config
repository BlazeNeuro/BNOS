#!/bin/sh
set -e

lb config noauto \
    --mode debian \
    --distribution trixie \
    --parent-distribution trixie \
    --architecture amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --system live \
    --binary-images iso-hybrid \
    --bootloader syslinux \
    --debian-installer false \
    --apt-recommends true \
    --apt-indices false \
    --apt-source-archives false \
    --memtest none \
    --security true \
    --updates true \
    --backports true \
    --mirror-bootstrap "http://deb.debian.org/debian/" \
    --mirror-chroot "http://deb.debian.org/debian/" \
    --mirror-chroot-security "http://security.debian.org/debian-security/" \
    --mirror-binary "http://deb.debian.org/debian/" \
    --mirror-binary-security "http://security.debian.org/debian-security/" \
    --keyring-packages debian-archive-keyring \
    --bootappend-live "boot=live components locales=en_US.UTF-8 keyboard-layouts=us hostname=bnos username=live" \
    --iso-application "BNOS" \
    --iso-publisher "BlazeNeuro; https://blazeneuro.com" \
    --iso-volume "BNOS Live" \
    "${@}"
